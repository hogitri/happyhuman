{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./obsidian/**)",
      "WebSearch",
      "WebFetch",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run dev *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./obsidian/Daily/**)",
      "Edit(./obsidian/Daily/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vault-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    }
  },
  "enabledPlugins": {
    "claude-seo@agricidaniel-claude-seo": true
  }
}
